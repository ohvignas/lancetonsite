{
  "mcpServers": {
    "fal": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp-relay"
    },
    "openrouter": {
      "type": "http",
      "url": "https://mcp.openrouter.ai/mcp"
    },
    "hostinger": {
      "type": "http",
      "url": "https://mcp.hostinger.com"
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth"
    },
    "ui-skills": {
      "type": "http",
      "url": "https://www.ui-skills.com/mcp"
    },
    "dataforseo": {
      "type": "http",
      "url": "https://mcp.dataforseo.com/v3/mcp"
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git@v1.0.3#subdirectory=mcp",
        "blender-mcp"
      ]
    }
